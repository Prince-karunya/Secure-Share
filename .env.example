DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
SHARE_BASE_URL=https://your-project.vercel.app
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
S3_BUCKET_NAME=your-private-bucket
S3_REGION=auto
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-storage-access-key
S3_SECRET_ACCESS_KEY=your-storage-secret
CRON_SECRET=replace-with-a-random-cron-secret
